# AFTERSHOCK runtime configuration. Never commit real tokens.
# Copy to .env and fill values locally. This file contains no real credentials.

# Copy the Zetaris REST URL from the running installation's documentation.
ZETARIS_REST_URL=
# Local installs normally use organization 1; confirm for your instance.
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=

# Copy the Runtime base URL and token from Nightshift's Console.
# The URL must be reachable from WSL, where this application runs.
METERLESS_BASE_URL=
METERLESS_RUNTIME_TOKEN=
# Select a routing mode returned by authenticated Runtime model discovery.
METERLESS_MODEL=
METERLESS_APP_ID=aftershock

# Configure the NVIDIA provider key inside Nightshift's Providers settings.

# sample: credential-free deterministic policy. live: real Zetaris + Nightshift.
APP_MODE=sample
PORT=4317
# Server bind address; Docker sets this to 0.0.0.0.
APP_HOST=127.0.0.1
# Exact public HTTPS origin, without trailing slash, for a hosted UI.
# Leave blank for localhost. This is an origin check, not authentication.
APP_ORIGIN=
# Persist this directory on a mounted disk when hosting.
DATA_DIR=data/runtime
SOURCE_PORT=4318
ZETARIS_DATABASE=aftershock_ops
# A source-server address reachable from the Zetaris Docker network.
SOURCE_PUBLIC_URL=
